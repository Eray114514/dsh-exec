#!/usr/bin/env node
/*
 * dshx — one-line external access to DeepSeek Harness.
 *
 * The desktop host runs the agent (so the session appears live in the sidebar);
 * this script only talks to its local bridge. Token/port come from
 * <DSH_HOME>/storages/dsh-exec.json, written by the host plugin at boot.
 *
 * Usage:
 *   dshx "TASK"
 *   dshx --cwd D:/repo --mode ptc "TASK"
 *   dshx --session session-… "FOLLOW UP"
 *   dshx --json "TASK"          # NDJSON events (codex exec --json style)
 *   dshx --verbose "TASK"       # live execution trace on stderr
 *   dshx --log RUN_ID           # replay a run's buffered execution records
 *   dshx --task-file task.md    # multi-line task ('-' = stdin)
 *   dshx --status / --runs / --stop RUN_ID
 *
 * Default: ONLY the final answer on stdout; stderr stays silent unless
 * something fails. Execution records are always opt-in.
 */

// The plugin package is `"type": "module"`, and Node applies that to an
// extensionless entry too — so this shim is ESM even though it has no `.mjs`.
import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import readline from 'node:readline';
import { Readable } from 'node:stream';

const BRIDGE = process.env.DSH_HOME
  ? path.join(process.env.DSH_HOME, 'storages', 'dsh-exec.json')
  : path.join(os.homedir(), '.dsh', 'storages', 'dsh-exec.json');

const HELP = `Usage: dshx [options] "TASK"

Options:
  --cwd DIR          working directory (also decides the sidebar group)
  --session ID       continue an existing session instead of creating one
  --mode MODE        agent preset: standard | ptc | minimal | cordis
                     (standard = full coding agent, ptc = the model writes code
                     that dispatches tools, minimal = bash + editor only,
                     cordis = standard + runtime/preset authoring)
  --model MODEL      override the model for this run only
  --provider NAME    provider for --model (default: resolved by the host)
  --effort LEVEL     off | low | medium | high | xhigh
  --permission MODE  read-only | workspace-write | danger-full-access
  --approval POLICY  ask | never | on-request
  --task-file PATH   read the task from a UTF-8 file ('-' = stdin).
                     REQUIRED for multi-line prompts on Windows: cmd.exe
                     truncates an argument at its first newline.
  --json             emit all NDJSON events on stdout
  --verbose          echo every event on stderr (live execution trace)
  --log RUN_ID       replay a run's buffered execution records (opt-in)
  --status           bridge status and run counts
  --runs             list runs
  --stop RUN_ID      stop a running run
  --help             this help

Default: only the final answer on stdout; stderr is silent unless something
fails. Execution records are opt-in via --verbose / --json / --log / --runs.
Exit 0 on turn/end.`;

function parseArgs(argv) {
  const opts = { mode: undefined, json: false, verbose: false };
  const rest = [];
  const withValue = new Set([
    'cwd', 'session', 'mode', 'model', 'provider', 'effort', 'permission', 'approval', 'stop', 'log',
    'task-file',
  ]);
  for (let i = 0; i < argv.length; i += 1) {
    const arg = argv[i];
    if (arg === '--help' || arg === '-h') { opts.help = true; continue; }
    if (arg === '--json') { opts.json = true; continue; }
    if (arg === '--verbose' || arg === '-v') { opts.verbose = true; continue; }
    if (arg === '--status') { opts.status = true; continue; }
    if (arg === '--runs') { opts.runs = true; continue; }
    if (arg.startsWith('--')) {
      const eq = arg.indexOf('=');
      const key = (eq >= 0 ? arg.slice(2, eq) : arg.slice(2)).replace(/^--/, '');
      if (!withValue.has(key)) {
        throw new Error(`unknown option --${key}`);
      }
      const value = eq >= 0 ? arg.slice(eq + 1) : argv[++i];
      if (value === undefined) throw new Error(`--${key} needs a value`);
      opts[key] = value;
      continue;
    }
    rest.push(arg);
  }
  opts.task = rest.join(' ').trim();
  if (opts['task-file'] !== undefined) {
    opts.taskFile = opts['task-file'];
    delete opts['task-file'];
  }
  return opts;
}

/**
 * Read a task without going through the command line. On Windows an argument
 * containing a newline is truncated at that newline by cmd.exe, which silently
 * turns a long prompt into its first paragraph.
 */
async function readTask(file) {
  let raw;
  if (file === '-') {
    const chunks = [];
    for await (const chunk of process.stdin) chunks.push(chunk);
    raw = Buffer.concat(chunks).toString('utf8');
  } else {
    raw = fs.readFileSync(path.resolve(file), 'utf8');
  }
  const value = raw.replace(/^\uFEFF/, '').trim();
  if (value.length === 0) throw new Error(`task file '${file}' is empty`);
  return value;
}

function readBridge() {
  let raw;
  try {
    raw = JSON.parse(fs.readFileSync(BRIDGE, 'utf8'));
  } catch {
    throw new Error(
      `no bridge file at ${BRIDGE} — start the DeepSeek Harness desktop app with the dsh-exec plugin loaded`,
    );
  }
  if (!raw.base || !raw.token || !raw.port) {
    throw new Error(`bridge file ${BRIDGE} is incomplete`);
  }
  try {
    process.kill(raw.pid, 0); // existence check, does not signal
  } catch {
    throw new Error(`bridge host pid ${raw.pid} is gone — restart the desktop app`);
  }
  return raw;
}

async function api(bridge, pathname, options = {}) {
  const url = bridge.base + pathname;
  const res = await fetch(url, {
    method: options.method ?? 'GET',
    headers: {
      authorization: `Bearer ${bridge.token}`,
      ...(options.body === undefined ? {} : { 'content-type': 'application/json' }),
    },
    ...(options.body === undefined ? {} : { body: JSON.stringify(options.body) }),
    ...(options.signal === undefined ? {} : { signal: options.signal }),
  });
  const text = await res.text();
  let body;
  try { body = JSON.parse(text); } catch { body = { raw: text }; }
  if (!res.ok) {
    throw new Error(`${res.status} ${pathname}: ${body.error ?? body.raw ?? 'request failed'}`);
  }
  return body;
}

function emit(jsonMode, event) {
  if (jsonMode) process.stdout.write(`${JSON.stringify(event)}\n`);
}

function describe(event) {
  if (event.type === 'text') return `text +${String(event.text ?? '').length} chars`;
  if (event.type === 'progress') {
    const hint = event.phase === 'retry-wait'
      ? ' — waiting out a 429, normal for Gemini, not a crash'
      : '';
    return `alive ${Math.round(event.elapsedMs / 1000)}s, ${event.steps} steps, ${event.retries} retries, silent ${Math.round(event.silentMs / 1000)}s${hint}`;
  }
  if (event.phase === 'retry') {
    return `429 retry ${event.code} — waiting ${Math.round((event.delayMs ?? 0) / 1000)}s, normal for Gemini, turn still running`;
  }
  return `${event.type}${event.phase ? ':' + event.phase : ''}${event.code ? ' ' + event.code : ''}`;
}

/** Human-readable one-line summary for `dshx --log` (metadata only, no text). */
function formatLogLine(event) {
  const at = new Date(event.at ?? 0).toISOString().slice(11, 19);
  const kind = `${event.type}${event.phase ? ':' + event.phase : ''}`;
  let detail = '';
  if (event.type === 'text' || event.type === 'thinking') {
    detail = `+${String(event.text ?? '').length} chars`;
  } else if (event.type === 'progress') {
    detail = `alive ${Math.round(event.elapsedMs / 1000)}s, ${event.steps} steps, ${event.retries} retries, silent ${Math.round(event.silentMs / 1000)}s${event.phase === 'retry-wait' ? ' [429 wait]' : ''}`;
  } else if (event.phase === 'retry') {
    detail = `${event.code}, wait ${Math.round((event.delayMs ?? 0) / 1000)}s`;
  } else if (event.type === 'tool_call') {
    detail = String(event.tool ?? '');
  } else if (event.type === 'session') {
    detail = String(event.sessionId ?? '');
  } else if (event.type === 'final') {
    detail = `text ${String(event.text ?? '').length} chars, reason ${String(event.reason?.kind ?? 'unknown')}`;
  } else if (event.phase === 'step_start' || event.phase === 'step_end') {
    detail = `turn ${event.turn ?? '?'} step ${event.step ?? '?'}`;
  } else if (event.message) {
    detail = String(event.message);
  }
  return `${at}  ${kind.padEnd(22)} ${detail}`;
}

async function streamEvents(bridge, runId, opts, signal) {
  let since = 0;
  let final;
  for (let attempt = 0; attempt < 30 && final === undefined; attempt += 1) {
    const url = `/dsh-exec/events.jsonl?runId=${encodeURIComponent(runId)}&since=${since}`;
    let res;
    try {
      res = await fetch(bridge.base + url, {
        headers: { authorization: `Bearer ${bridge.token}` },
        signal,
      });
    } catch (error) {
      if (signal.aborted) return final;
      throw error;
    }
    if (!res.ok) throw new Error(`${res.status} ${url}: ${await res.text()}`);

    const rl = readline.createInterface({ input: Readable.fromWeb(res.body), crlfDelay: Infinity });
    for await (const line of rl) {
      if (line.trim().length === 0) continue;
      let event;
      try { event = JSON.parse(line); } catch { continue; }
      since = Math.max(since, event.seq ?? since);
      emit(opts.json, event);
      // Default is silent: progress only exists when the caller opted in.
      if (opts.verbose && !opts.json) process.stderr.write(`[dshx] ${describe(event)}\n`);
      if (event.type === 'final') { final = event; break; }
    }
    rl.close();
    if (final !== undefined) break;
    if (signal.aborted) break;
    await new Promise((resolve) => setTimeout(resolve, 1000));
  }
  return final;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help) { process.stdout.write(`${HELP}\n`); return; }
  const bridge = readBridge();

  if (opts.status) {
    process.stdout.write(`${JSON.stringify(await api(bridge, '/dsh-exec/status.json'), null, 2)}\n`);
    return;
  }
  if (opts.runs) {
    process.stdout.write(`${JSON.stringify(await api(bridge, '/dsh-exec/runs.json'), null, 2)}\n`);
    return;
  }
  if (opts.stop) {
    const result = await api(bridge, '/dsh-exec/runs.json', {
      method: 'POST', body: { action: 'stop', runId: opts.stop },
    });
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
    return;
  }
  if (opts.log) {
    const url = `/dsh-exec/events.jsonl?runId=${encodeURIComponent(opts.log)}&since=0&snapshot=1`;
    const res = await fetch(bridge.base + url, {
      headers: { authorization: `Bearer ${bridge.token}` },
    });
    if (!res.ok) throw new Error(`${res.status} ${url}: ${await res.text()}`);
    const rl = readline.createInterface({ input: Readable.fromWeb(res.body), crlfDelay: Infinity });
    for await (const line of rl) {
      if (line.trim().length === 0) continue;
      if (opts.json) {
        process.stdout.write(`${line}\n`);
        continue;
      }
      let event;
      try { event = JSON.parse(line); } catch { continue; }
      process.stdout.write(`${formatLogLine(event)}\n`);
    }
    rl.close();
    return;
  }
  if (opts.taskFile !== undefined) {
    if (opts.task.length > 0) {
      throw new Error('pass either --task-file or a positional task, not both');
    }
    opts.task = await readTask(opts.taskFile);
  }
  if (!opts.task) {
    process.stderr.write(`${HELP}\n`);
    process.exitCode = 2;
    return;
  }

  const body = { task: opts.task };
  for (const key of ['cwd', 'mode', 'model', 'provider', 'effort', 'permission', 'approval']) {
    if (opts[key] !== undefined) body[key] = opts[key];
  }
  if (opts.session !== undefined) body.sessionId = opts.session;

  const created = await api(bridge, '/dsh-exec/runs.json', { method: 'POST', body });
  const run = created.run;
  if (!run) throw new Error('bridge did not return a run');
  if (opts.verbose && !opts.json) {
    process.stderr.write(
      `[dshx] run ${run.runId} | session ${run.sessionId} | mode ${run.mode} | ` +
        `visible in the desktop sidebar | replay with --log ${run.runId}\n`,
    );
  }
  if (created.ok === false || run.state === 'failed') {
    throw new Error(run.error ?? 'run failed to start');
  }

  const controller = new AbortController();
  const onSigint = () => controller.abort();
  process.on('SIGINT', onSigint);

  const final = await streamEvents(bridge, run.runId, opts, controller.signal);
  process.off('SIGINT', onSigint);

  if (final === undefined) {
    throw new Error('event stream ended before a final frame; the run may still be active in the desktop app');
  }
  if (!opts.json) process.stdout.write(`${final.text ?? ''}\n`);
  const reason = final.reason?.kind ?? 'unknown';
  if (reason !== 'completed') {
    process.stderr.write(`[dshx] turn ended with reason: ${reason}\n`);
    process.exitCode = 1;
  }
}

main().catch((error) => {
  process.stderr.write(`[dshx] ${error.message}\n`);
  process.exitCode = 1;
});
