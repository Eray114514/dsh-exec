{
  "name": "dsh-exec",
  "version": "0.1.2",
  "description": "Run DeepSeek Harness from a shell, a script or another agent: one line in, the final answer out, and the session appears live in the desktop sidebar.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lifecycle": "./lifecycle.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-exec": "bin/dshx",
    "dshx": "bin/dshx"
  },
  "files": [
    "index.js",
    "client.js",
    "lifecycle.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "bin"
  ],
  "license": "MIT",
  "author": "Eray114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eray114514/dsh-exec.git"
  },
  "homepage": "https://github.com/Eray114514/dsh-exec#readme",
  "bugs": {
    "url": "https://github.com/Eray114514/dsh-exec/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "deepseek",
    "deepseek-harness",
    "cli",
    "exec",
    "headless",
    "automation",
    "ci",
    "agent",
    "bridge",
    "ndjson"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node tests/offline.cjs && node tests/client.cjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "meta": {
    "title": "DSH Exec",
    "description": "One-line DeepSeek Harness execution for shells, scripts and CI: sessions are created inside the desktop host, so they show up live in the sidebar."
  }
}
